# Copy to .env.local and fill in. Non-secret defaults live in the committed .env.

# Mapbox GL JS public token (pk.*). Restrict it to your deployed domain in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Claude API key (server-side only): Regen coaching tips and the Next Move explanation.
ANTHROPIC_API_KEY=
# Model for both; the committed .env sets the default.
# ANTHROPIC_MODEL=
# Max Claude explanations per server instance per UTC day (template is used beyond it).
AI_DAILY_CAP=50

# Capital One Nessie sandbox (server-side only).
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
# Persona → team-controlled Nessie customer id, e.g. maria:<id>,devon:<id>,kai:<id>
NESSIE_CUSTOMERS=
# Dev machines only: enables POST /api/dev/seed-nessie on localhost. Never set in Vercel.
# NESSIE_SEED_ALLOW=1

# SerpAPI market research (server-side only).
SERPAPI_API_KEY=
# Max live SerpAPI searches per server instance per UTC day (cache/saved results beyond it).
MARKET_DAILY_CAP=20

# Drive import upload limit in bytes (4 MiB).
IMPORT_MAX_BYTES=4194304

# Optional: Supabase/Postgres for trips and leaderboard (JSON files in /data work to start)
# DATABASE_URL=
