# Mapbox GL JS public token (pk.*). Restrict it to your deployed domain in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Claude API key for the coaching tips (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: Supabase/Postgres for trips and leaderboard (JSON files in /data work to start)
# DATABASE_URL=

# Open-Meteo (weather, elevation) and Overpass (OSM surface, stops) need no key.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Demo defaults for the savings estimator
NEXT_PUBLIC_DEFAULT_GAS_PRICE=3.00
NEXT_PUBLIC_DEFAULT_TRIPS_PER_DAY=2
