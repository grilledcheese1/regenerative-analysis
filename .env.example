# Copy to .env.local and fill in. Non-secret defaults live in the committed .env.
# Every variable is optional: without it the app falls back to fixtures/templates and says so on screen.

# Mapbox GL JS public token (pk.*). Restrict it to your deployed domains in the Mapbox dashboard.
# Blank = the Drives tab shows a static route preview ("Map tiles unavailable").
NEXT_PUBLIC_MAPBOX_TOKEN=

# Claude API key and model for coaching tips and explanations (server-side only).
# Default model is set in src/lib/env.ts (claude-sonnet-5-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Max AI calls per day across the deployment (default 50).
AI_DAILY_CAP=

# Capital One Nessie sandbox (server-side only).
# NESSIE_BASE_URL default: http://api.nessieisreal.com
# NESSIE_CUSTOMERS format: maria:<id>,devon:<id>,kai:<id>
NESSIE_API_KEY=
NESSIE_BASE_URL=
NESSIE_CUSTOMERS=

# Set to 1 on a dev machine only to allow seeding the sandbox. NEVER set this in Vercel.
NESSIE_SEED_ALLOW=

# SerpAPI for market listings (server-side only) and its daily cap (default 100).
SERPAPI_API_KEY=
MARKET_DAILY_CAP=

# Largest accepted drive import in bytes (default 4194304 = 4 MiB).
IMPORT_MAX_BYTES=
