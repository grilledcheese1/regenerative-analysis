# Copy to .env.local and fill in. Non-secret defaults live in the committed .env.

# Signs the demo account session cookie. Required in production; any long random string.
AUTH_SECRET=

# Claude API key (server-side only): the Next Move explanation.
ANTHROPIC_API_KEY=
# Model for both; the committed .env sets the default.
# ANTHROPIC_MODEL=
# Max Claude explanations per server instance per UTC day (template is used beyond it).
AI_DAILY_CAP=50

# Capital One Nessie sandbox (server-side only).
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
# Persona → team-controlled Nessie customer id, e.g. maria:<id>,devon:<id>,kai:<id>
NESSIE_CUSTOMERS=
# Dev machines only: enables POST /api/dev/seed-nessie on localhost. Never set in Vercel.
# NESSIE_SEED_ALLOW=1

# SerpAPI market research (server-side only).
SERPAPI_API_KEY=
# Max live SerpAPI searches per server instance per UTC day (cache/saved results beyond it).
MARKET_DAILY_CAP=20

# Drive import upload limit in bytes (4 MiB).
IMPORT_MAX_BYTES=4194304

# Ask Next Move assistant (server-side only). AI_PROVIDER: meta | anthropic | none. Unset uses whichever is configured, Meta first.
# With no key at all the assistant still answers from deterministic templates.
AI_PROVIDER=
META_API_KEY=
# From Meta's developer docs (OpenAI-style, no trailing /chat/completions); do not guess.
META_BASE_URL=
# META_MODEL=muse-spark-1.1
# Set to "anthropic" to try Claude once when Meta fails or its answer doesn't validate.
AI_FALLBACK_PROVIDER=
# Max live assistant model calls per server instance per UTC day, and questions per minute per visitor.
ASSISTANT_DAILY_CAP=
ASSISTANT_RATE_PER_MIN=
